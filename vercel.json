{
  "buildCommand": "pnpm --filter ./artifacts/api-server run build && pnpm --filter ./artifacts/matka-app run build && pnpm --filter ./artifacts/admin run build",
  "outputDirectory": "artifacts/matka-app/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
