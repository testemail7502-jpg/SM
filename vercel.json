{
  "buildCommand": "pnpm --filter ./artifacts/matka-app run build",
  "outputDirectory": "artifacts/matka-app/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
